{
    "_version": "1.85.0",
    "sap.app": {
        "id": "ku-card",
        "type": "card",
        "title": "{{CARD_TITLE}}",
        "subTitle": "{{CARD_SUBTITLE}}",
        "applicationVersion": {
            "version": "1.0.1"
        },
        "i18n": "i18n/i18n.properties"
    },
    "sap.ui": {
        "technology": "UI5"
    },
    "sap.card": {
        "type": "Component",
        "designtime": "dt/configuration",
        "header": {
            "icon": {
                "src": "sap-icon://education",
                "shape": "Circle",
                "backgroundColor": "Accent10"
            },
            "title": "{{CARD_TITLE}}",
            "subTitle": "{{CARD_SUBTITLE}}",
            "status": {
                "text": "{{HEADER_STATUS}}"
            }
        },
        "content": {
            "minHeight": "24rem"
        }
    },
    "sap.ui5": {
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {}
            }
        },
        "rootView": {
            "viewName": "view.Main",
            "type": "XML",
            "async": true,
            "id": "main"
        }
    }
}
