{
	"sap.package": {
		"id": "ns.ku_loket",
		"packageVersion": {
			"version": "1.1.9",
			"upgradeNotification": "all"
		},
		"i18n": "i18n/i18n.properties",
		"icon": "sap-icon://accept",
		"title": "UI card ku ",
		"subTitle": "",
		"shortTitle": "",
		"info": "",
		"description": "",
		"tags": {
			"keywords": []
		},
		"vendor": {
			"id": "",
			"name": "",
			"url": ""
		},
		"products": "",
		"categories": "",
		"scope": "external",
		"license": {
			"text": "",
			"url": ""
		},
		"homepage": {
			"text": "",
			"url": ""
		},
		"support": {
			"url": ""
		},
		"contents": [
			{
				"manifest": {
					"_version": "1.27.0",
					"_generator": "cpkg-project-template",
					"sap.artifact": {
						"id": "ku-card",
						"type": "card",
						"title": "{{CARD_TITLE}}",
						"subTitle": "{{CARD_SUBTITLE}}",
						"i18n": "i18n/i18n.properties",
						"artifactVersion": {
							"version": "1.0.1"
						}
					}
				},
				"baseURL": "artifacts/ku_card"
			}
		],
		"documentation": {
			"url": ""
		},
		"consumption": [],
		"dependencies": {
			"products": [],
			"services": []
		},
		"destinations": [],
		"cdmEntities": [
			{
				"_version": "3.2.0",
				"identification": {
					"id": "ku-card.role",
					"title": "KU Card Role",
					"entityType": "role"
				},
				"payload": {
					"apps": [
						{
							"id": "ku-card.app"
						}
					]
				},
				"texts": [
					{
						"locale": "",
						"textDictionary": {
							"description": "Business App Description"
						}
					}
				]
			},
			{
				"_version": "3.2.0",
				"identification": {
					"id": "ku-card.app",
					"title": "{{CARD_TITLE}}",
					"entityType": "businessapp",
					"description": "{{description}}"
				},
				"payload": {
					"visualizations": {
						"ku-card.viz": {
							"vizType": "sap.card",
							"vizConfig": {
								"_version": "1.85.0",
								"sap.app": {
									"id": "ku-card",
									"type": "card",
									"title": "{{CARD_TITLE}}",
									"subTitle": "{{CARD_SUBTITLE}}",
									"applicationVersion": {
										"version": "1.0.1"
									},
									"i18n": "i18n/i18n.properties"
								},
								"sap.ui": {
									"technology": "UI5"
								},
								"sap.card": {
									"type": "Component",
									"designtime": "dt/configuration",
									"header": {
										"icon": {
											"src": "sap-icon://education",
											"shape": "Circle",
											"backgroundColor": "Accent10"
										},
										"title": "{{CARD_TITLE}}",
										"subTitle": "{{CARD_SUBTITLE}}",
										"status": {
											"text": "{{HEADER_STATUS}}"
										}
									},
									"content": {
										"minHeight": "24rem"
									}
								},
								"sap.ui5": {
									"dependencies": {
										"minUI5Version": "1.120.0",
										"libs": {
											"sap.m": {},
											"sap.ui.core": {}
										}
									},
									"rootView": {
										"viewName": "view.Main",
										"type": "XML",
										"async": true,
										"id": "main"
									}
								}
							},
							"vizResources": {
								"artifactId": "ku-card"
							}
						}
					}
				},
				"texts": [
					{
						"locale": "",
						"textDictionary": {
							"CARD_TITLE": "Mijn Resultaten",
							"CARD_SUBTITLE": "Bachelor Electronica-ICT (Sint-Katelijne-Waver)",
							"HEADER_STATUS": "vakken"
						}
					},
					{
						"locale": "en",
						"textDictionary": {
							"CARD_TITLE": "My Results",
							"CARD_SUBTITLE": "Bachelor Electronics-ICT (Sint-Katelijne-Waver)",
							"HEADER_STATUS": "courses"
						}
					}
				]
			}
		]
	}
}